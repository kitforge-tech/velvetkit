{
  "name": "velvetkit-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build ./app/javascript/application.js ./app/javascript/ag_grid.ts ./app/javascript/chart_js.ts ./app/javascript/vanilla_calendar.ts --outdir ./app/assets/builds --minify",
    "build:css": "bun run build:css:site && bun run build:css:shop",
    "build:css:site": "bunx @tailwindcss/cli -i ./app/assets/stylesheets/application.tailwind.css -o ./app/assets/builds/application.css --minify",
    "build:css:shop": "bunx @tailwindcss/cli -i ./app/assets/stylesheets/daily_goods.tailwind.css -o ./app/assets/builds/daily_goods.css --minify"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.4",
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.16",
    "@rails/activestorage": "^8.1.4",
    "@tailwindcss/cli": "^4.1.0",
    "ag-grid-community": "^36.1.0",
    "chart.js": "^4.6.1",
    "lucide-static": "0.545.0",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.4.0",
    "vanilla-calendar-pro": "^3.4.0"
  }
}

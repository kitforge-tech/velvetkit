<%# The grid needs a server to page, sort and filter; this page brings one. %>
<%= render(UI::DataGrid.new(url: demo_rows_path, page_size: 10)) do |grid|
      grid.column(:id, "ID", width: 100, type: :number)
      grid.column(:name, "Customer")
      grid.column(:plan, "Plan")
      grid.column(:seats, "Seats", width: 120, type: :number)
    end %>

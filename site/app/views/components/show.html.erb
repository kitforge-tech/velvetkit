<% content_for :title, @component.title %>
<% content_for :description, @component.description %>
<% names = ComponentDoc.names %>
<% index = names.index(@component.name) %>

<article class="space-y-12">
  <header class="space-y-4">
    <%= render(UI::Breadcrumb.new(size: :sm)) do |bc| %>
      <% bc.with_item(href: docs_path, text: "Docs") %>
      <% bc.with_item(href: components_path, text: "Components") %>
      <% bc.with_item(href: component_path(@component), text: @component.title, current: true) %>
    <% end %>
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="text-4xl font-bold tracking-tight"><%= @component.title %></h1>
      <%= render(UI::Badge.new(variant: :outline, class: "font-mono")) { @component.class_name } %>
    </div>
    <p class="max-w-2xl text-lg text-muted-foreground"><%= @component.description %></p>
<div data-controller="clipboard" class="flex flex-wrap items-center gap-2">
  <span hidden data-clipboard-target="source"><%= @component.to_markdown %></span>
  <%= render(UI::Menu.new) do |menu| %>
    <% menu.with_trigger(variant: :outline, size: :sm) do %>
      <%= render(UI::Icon.new(name: "sparkles", size: :sm, class: "text-primary dark:text-fuchsia-300")) %>
      Ask AI
      <%= render(UI::Icon.new(name: "chevron-down", size: :xs)) %>
    <% end %>
    <% menu.with_content(class: "w-56") do |content| %>
      <% content.with_item(data: { action: "clipboard#copy" }) do %>
        <%= render(UI::Icon.new(name: "copy", size: :sm, data: { clipboard_target: "idle" })) %>
        <%= render(UI::Icon.new(name: "check", size: :sm, class: "text-emerald-500", hidden: true, data: { clipboard_target: "done" })) %>
        Copy as Markdown
      <% end %>
      <% content.with_item(href: component_path(@component, format: :md)) do %>
        <%= render(UI::Icon.new(name: "file-text", size: :sm)) %>View as Markdown
      <% end %>
      <% content.with_divider %>
      <% ask_ai_links(component_url(@component, format: :md), @component.title).each do |assistant, url| %>
        <% content.with_item(href: url, target: "_blank", rel: "noopener") do %>
          <%= render(UI::Icon.new(name: "external-link", size: :sm)) %>Open in <%= assistant %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
  </header>

  <section class="grid grid-cols-1 gap-6 lg:grid-cols-[1fr_18rem]">
    <div class="space-y-3">
      <h2 id="install" class="text-xl font-semibold">Add it</h2>
      <%= code_block(@component.add_command) %>
    </div>
    <%= render(UI::Card.new) do |card| %>
      <% card.with_header do |header| %>
        <% header.with_title(class: "text-base") { "Comes with" } %>
      <% end %>
      <% card.with_content(class: "space-y-4 text-sm") do %>
        <div>
          <p class="mb-2 text-xs font-medium uppercase tracking-wide text-muted-foreground">Components</p>
          <div class="flex flex-wrap gap-1.5">
            <% if @component.dependencies.any? %>
              <% @component.dependencies.each do |dependency| %>
                <%= link_to component_path(dependency) do %>
                  <%= render(UI::Badge.new(variant: :secondary, class: "hover:bg-primary hover:text-primary-foreground transition-colors")) { dependency.humanize } %>
                <% end %>
              <% end %>
            <% else %>
              <span class="text-muted-foreground">None, it stands alone</span>
            <% end %>
          </div>
        </div>
        <% if @component.stimulus_controllers.any? %>
          <div>
            <p class="mb-2 text-xs font-medium uppercase tracking-wide text-muted-foreground">Stimulus</p>
            <div class="flex flex-wrap gap-1.5">
              <% @component.stimulus_controllers.each do |controller| %>
                <%= render(UI::Badge.new(variant: :outline, class: "font-mono")) { controller } %>
              <% end %>
            </div>
          </div>
        <% end %>
        <% if @component.packages.any? || @component.gems.any? %>
          <div>
            <p class="mb-2 text-xs font-medium uppercase tracking-wide text-muted-foreground">Installs</p>
            <div class="flex flex-wrap gap-1.5">
              <% @component.packages.each do |package| %>
                <%= render(UI::Badge.new(variant: :outline)) do |badge| %><% badge.with_leading_icon(name: "package") %><%= package %><% end %>
              <% end %>
              <% @component.gems.each do |gem_name| %>
                <%= render(UI::Badge.new(variant: :outline)) do |badge| %><% badge.with_leading_icon(name: "gem") %><%= gem_name %><% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </section>

<% if lookup_context.exists?(@component.name, [ "components/demos" ], true) %>
  <section class="space-y-4">
    <div class="flex items-center gap-3">
      <h2 id="demo" class="text-2xl font-semibold tracking-tight">Live demo</h2>
      <%= render(UI::Badge.new(variant: :secondary)) { "Talks to a server" } %>
    </div>
    <p class="text-muted-foreground">Sort a column, or filter one from its menu. Each change asks this site for a fresh page of 120 sample rows.</p>
    <%= render "components/demos/#{@component.name}" %>
  </section>
<% end %>

  <% if @component.examples.any? %>
    <section class="space-y-8">
      <h2 id="examples" class="text-2xl font-semibold tracking-tight">Examples</h2>
      <% @component.examples.each do |example| %>
        <div class="space-y-3" id="<%= example.key.dasherize %>">
          <h3 class="font-medium"><%= example.title %></h3>
          <%= render(UI::Tabs.new(default_value: "preview", size: :sm)) do |tabs| %>
            <% tabs.with_list do |list| %>
              <% list.with_trigger(value: "preview") do |trigger| %><% trigger.with_leading_icon(name: "eye") %>Preview<% end %>
              <% list.with_trigger(value: "code") do |trigger| %><% trigger.with_leading_icon(name: "code") %>Code<% end %>
            <% end %>
            <% tabs.with_panel(value: "preview", class: "pt-3") do %>
              <div class="relative min-h-40 rounded-xl border bg-[radial-gradient(var(--border)_1px,transparent_1px)] [background-size:16px_16px] p-6 sm:p-10">
                <%= render inline: example.source %>
              </div>
            <% end %>
            <% tabs.with_panel(value: "code", class: "pt-3") do %>
              <%= code_block(example.source, label: "#{example.key}.html.erb") %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </section>
  <% end %>

  <% if @component.signature || @component.slots.any? %>
    <section class="space-y-4">
      <h2 id="api" class="text-2xl font-semibold tracking-tight">API</h2>
      <% if @component.signature %>
        <%= code_block(@component.signature, label: "Arguments", language: "ruby") %>
      <% end %>
      <% if @component.slots.any? %>
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-sm text-muted-foreground">Slots:</span>
          <% @component.slots.each do |slot| %>
            <%= render(UI::Badge.new(variant: :secondary, class: "font-mono")) { slot } %>
          <% end %>
        </div>
      <% end %>
    </section>
  <% end %>

  <% if @component.notes %>
    <section class="space-y-4">
      <h2 id="notes" class="text-2xl font-semibold tracking-tight">Notes</h2>
      <%= render(UI::Card.new) do |card| %>
        <% card.with_content(class: "pt-6") do %>
          <div class="whitespace-pre-wrap text-sm leading-relaxed text-muted-foreground"><%= @component.notes %></div>
        <% end %>
      <% end %>
    </section>
  <% end %>

  <%= render "docs/pager",
             previous_page: index.positive? ? [ names[index - 1].humanize, component_path(names[index - 1]) ] : [ "All components", components_path ],
             next_page: names[index + 1] && [ names[index + 1].humanize, component_path(names[index + 1]) ] %>
</article>

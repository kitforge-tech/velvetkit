<%# The hero: the velvet band, plain confident type, and a rail of real
    product UI built from the kit, scrolled sideways. Nothing here is a
    picture of UI; all of it is UI. %>
<% blocks = {
     "sign_in" => "UI::Input · UI::PasswordInput", "team" => "UI::Avatar · UI::Badge",
     "notifications" => "UI::Switch", "plans" => "UI::RadioGroup · UI::Select",
     "usage" => "UI::Badge", "tasks" => "UI::Tabs · UI::Badge",
     "schedule" => "UI::DatePicker · UI::Select", "danger" => "UI::Alert · UI::Dialog",
     "faq" => "UI::Accordion", "records" => "UI::Table · UI::Pagination"
   } %>
<section class="relative isolate overflow-hidden bg-[#1c0a30] text-white">
  <div aria-hidden="true" class="absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-[radial-gradient(120%_80%_at_15%_0%,#4D1A7F_0%,transparent_60%),radial-gradient(90%_70%_at_100%_100%,#2e0f52_0%,transparent_65%)]"></div>
    <%# Fine diagonal weave, the nap of the fabric. %>
    <div class="absolute inset-0 opacity-[0.07] bg-[repeating-linear-gradient(135deg,white_0_1px,transparent_1px_7px)]"></div>
  </div>

  <div class="mx-auto grid max-w-6xl grid-cols-1 items-end gap-8 px-4 pt-16 sm:px-6 lg:grid-cols-[1.3fr_1fr] lg:pt-20">
    <div>
      <p class="relative inline-flex items-center px-2.5 py-1 font-mono text-xs text-white/70">
        <span aria-hidden="true" class="absolute top-0 left-0 size-2 border-t border-l border-[#FFA552]"></span>
        <span aria-hidden="true" class="absolute right-0 bottom-0 size-2 border-r border-b border-[#FFA552]"></span>
        Rails 7.1+ · ViewComponent · Tailwind 4
      </p>
      <h1 class="mt-5 text-[2.5rem] leading-[1.05] font-extrabold tracking-tight text-balance sm:text-[3.2rem]">
        <span class="text-[#d9b8ff]">Ship Rails UI</span><br>
        with components<br>
        you own.
      </h1>
    </div>
    <div class="space-y-6">
      <p class="text-lg text-pretty text-white/75">
        VelvetKit copies accessible ViewComponents into your app: only the ones you use, under your namespace,
        with their tests and previews. Your AI agent gets a reference to build with them.
      </p>
      <div class="flex flex-wrap gap-3">
        <%= render(UI::Link.new(href: docs_path, variant: :secondary, size: :lg, button_variant: true, class: "bg-white text-[#2e0f52] hover:bg-white/90", data: { umami_event: "cta-get-started" })) do |link| %>
          <% link.with_trailing_icon(name: "arrow-right") %>
          Get started
        <% end %>
        <%= render(UI::Link.new(href: components_path, variant: :outline, size: :lg, button_variant: true, class: "border-white/25 bg-white/5 text-white hover:bg-white/10 hover:text-white", data: { umami_event: "cta-browse-components" })) { "Browse #{ComponentDoc.names.size} components" } %>
      </div>
    </div>
  </div>

  <%# The rail: scroll it, swipe it, use the arrows, or focus it and use ← →. %>
  <div class="relative mt-14 pb-16" data-controller="rail">
    <div class="mx-auto mb-4 flex max-w-6xl items-center justify-between px-4 sm:px-6">
      <p class="font-mono text-xs text-white/55"><%= blocks.size %> screens, every one built from the kit and live</p>
      <div class="flex gap-2">
        <%= render(UI::Button.new(variant: :outline, size: :icon_sm, aria: { label: "Scroll back" }, class: "border-white/20 bg-white/5 text-white hover:bg-white/15 hover:text-white disabled:opacity-30",
                                  data: { action: "rail#previous", rail_target: "previous" })) { render(UI::Icon.new(name: "chevron-left", size: :sm)) } %>
        <%= render(UI::Button.new(variant: :outline, size: :icon_sm, aria: { label: "Scroll on" }, class: "border-white/20 bg-white/5 text-white hover:bg-white/15 hover:text-white disabled:opacity-30",
                                  data: { action: "rail#next", rail_target: "next" })) { render(UI::Icon.new(name: "chevron-right", size: :sm)) } %>
      </div>
    </div>
    <ul role="region" aria-label="Screens built from VelvetKit components" tabindex="0"
        class="flex snap-x snap-mandatory scroll-px-4 gap-5 overflow-x-auto px-4 pt-1 pb-6 [scrollbar-color:rgb(255_255_255/0.25)_transparent] [scrollbar-width:thin] focus:outline-none focus-visible:ring-2 focus-visible:ring-white/40 sm:scroll-px-6 sm:px-6 lg:scroll-px-[max(1.5rem,calc((100vw-72rem)/2+1.5rem))] lg:px-[max(1.5rem,calc((100vw-72rem)/2+1.5rem))]
               [mask-image:linear-gradient(to_right,transparent,black_2rem,black_calc(100%-4rem),transparent)]
               data-[at-start]:[mask-image:linear-gradient(to_right,black_calc(100%-4rem),transparent)]
               data-[at-end]:[mask-image:linear-gradient(to_right,transparent,black_2rem)]
               data-[at-start]:data-[at-end]:[mask-image:none]"
        data-rail-target="track" data-action="scroll->rail#update">
      <% blocks.each do |name, label| %>
        <%= render "pages/showcase/block", name: name, label: label %>
      <% end %>
    </ul>
  </div>
</section>

<div class="space-y-4">
  <div class="flex items-center justify-between">
    <h3 class="font-semibold">Team</h3>
    <%= render(UI::Button.new(size: :sm)) do |button| %><% button.with_leading_icon(name: "user-plus") %>Invite<% end %>
  </div>
  <ul class="divide-y">
    <% [ [ "AK", "Asha Kulkarni", "asha@example.com", "Owner" ], [ "RM", "Ravi Menon", "ravi@example.com", "Editor" ],
         [ "SJ", "Sara Joseph", "sara@example.com", "Viewer" ], [ "TO", "Tomás Ortega", "tomas@example.com", "Editor" ] ].each do |initials, name, email, role| %>
      <li class="flex items-center gap-3 py-2.5">
        <%= render(UI::Avatar.new(size: :sm)) { initials } %>
        <div class="min-w-0 flex-1">
          <p class="truncate text-sm font-medium"><%= name %></p>
          <p class="truncate text-xs text-muted-foreground"><%= email %></p>
        </div>
        <%= render(UI::Badge.new(variant: role == "Owner" ? :default : :outline, size: :sm)) { role } %>
      </li>
    <% end %>
  </ul>
</div>

<div class="group relative rounded-lg border bg-zinc-950 text-zinc-100 dark:bg-zinc-900" data-controller="clipboard">
  <% if label %>
    <div class="flex items-center gap-2 border-b border-white/10 px-4 py-2 text-xs text-zinc-400">
      <%= render(UI::Icon.new(name: "file-code", size: :xs)) %><%= label %>
    </div>
  <% end %>
  <div class="relative">
    <pre class="<%= wrap ? "whitespace-pre-wrap" : "overflow-x-auto" %> p-4 pr-14 text-[13px] leading-relaxed"><code class="vk-code" data-clipboard-target="source"><%= html %></code></pre>
    <%# Centred on the first line of code (p-4 + half a 21px line). %>
    <div class="absolute top-3 right-2">
      <span hidden role="tooltip" data-clipboard-target="label"
            class="pointer-events-none absolute right-1/2 bottom-full mb-2 translate-x-1/2 rounded-md bg-foreground px-2 py-1 text-xs font-medium whitespace-nowrap text-background shadow-md
                   after:absolute after:top-full after:left-1/2 after:-translate-x-1/2 after:border-4 after:border-transparent after:border-t-foreground after:content-['']"></span>
      <%= render(UI::Button.new(variant: :ghost, size: :icon_sm, aria: { label: "Copy code" },
                                class: "ring-offset-zinc-950 text-zinc-400 hover:bg-white/10 hover:text-white sm:opacity-0 sm:group-hover:opacity-100 sm:group-data-[copied]:opacity-100 focus:opacity-100",
                                data: { action: "clipboard#copy" })) do %>
        <%= render(UI::Icon.new(name: "copy", size: :sm, data: { clipboard_target: "idle" })) %>
        <%= render(UI::Icon.new(name: "check", size: :sm, class: "text-emerald-400", hidden: true, data: { clipboard_target: "done" })) %>
      <% end %>
    </div>
  </div>
  <span class="sr-only" role="status" data-clipboard-target="status"></span>
</div>

<%# Site footer: the brand, three columns of links, then the licence and maker. %>
<% columns = {
     "Docs" => DocsController::PAGES.except("lookbook").map { |page, title| [ title, page == "getting_started" ? docs_path : doc_path(page) ] },
     "Components" => [ [ "All components", components_path ], [ "Lookbook", "/lookbook" ], [ "Lookbook guide", doc_path("lookbook") ] ],
     "Resources" => [ [ "GitHub", ApplicationHelper::GITHUB_URL ], [ "RubyGems", ApplicationHelper::RUBYGEMS_URL ],
                      [ "llms.txt", llms_path ], [ "llms-full.txt", llms_full_path ] ]
   } %>
<footer class="border-t bg-muted/30">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="grid grid-cols-2 gap-x-6 gap-y-10 py-12 sm:grid-cols-3 lg:grid-cols-[2fr_1fr_1fr_1fr]">
      <div class="col-span-full space-y-4 lg:col-span-1">
        <%= render "layouts/logo" %>
        <p class="max-w-xs text-sm text-muted-foreground">
          Accessible ViewComponent UI for Rails, styled with Tailwind. Copied into your app, so you own every line.
        </p>
        <div class="flex items-center gap-2">
          <%= render(UI::Badge.new(variant: :outline)) { "v#{Velvetkit::VERSION}" } %>
          <%= render(UI::Link.new(href: ApplicationHelper::GITHUB_URL, variant: :ghost, size: :sm, button_variant: true,
                                  class: "size-7 rounded-md px-0 text-foreground",
                                  target: "_blank", rel: "noopener", aria: { label: "VelvetKit on GitHub" })) do %>
            <%= render(UI::Icon.new(name: "github", size: :sm)) %>
          <% end %>
        </div>
      </div>

      <% columns.each do |heading, links| %>
        <nav aria-label="<%= heading %>">
          <p class="mb-3 text-sm font-semibold text-foreground"><%= heading %></p>
          <ul class="space-y-2">
            <% links.each do |title, href| %>
              <% external = href.start_with?("http") %>
              <li>
                <%= link_to href, class: "inline-flex items-center gap-1 text-sm text-muted-foreground transition-colors hover:text-foreground",
                                  target: (external ? "_blank" : nil), rel: (external ? "noopener" : nil) do %>
                  <%= title %>
                  <% if external %><%= render(UI::Icon.new(name: "arrow-up-right", size: :xs, class: "opacity-60")) %><% end %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </nav>
      <% end %>
    </div>

    <div class="flex flex-col gap-4 border-t py-6 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; 2026 Rain Root. Released under the <%= link_to "MIT License", "#{ApplicationHelper::GITHUB_URL}/blob/main/LICENSE.txt", class: "underline-offset-4 hover:text-foreground hover:underline", target: "_blank", rel: "noopener" %>.</p>
      <%= render "layouts/built_by" %>
    </div>
  </div>
</footer>

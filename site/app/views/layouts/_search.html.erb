<%# Header search: ⌘K, Ctrl+K or / opens it (Ctrl+K on a Mac too, as it always
    has). The kit's own Command palette; the search controller around it only
    reports to analytics. %>
<div data-controller="search" data-action="ui--command:search->search#searched ui--command:select->search#picked">
  <%= render(UI::Command.new(dialog: true, shortcut: [ "mod+k", "ctrl+k", "/" ], sort_groups: true, id: "site-search",
                             label: "Search the docs", placeholder: "Search components and guides",
                             empty: "No matches. Try a component name, like “dialog”.")) do |command| %>
    <% command.with_trigger(size: :sm, aria: { label: "Search the docs" },
                            class: "w-9 justify-center px-0 sm:w-56 sm:justify-between sm:px-3") do %>
      <span class="flex items-center gap-2">
        <%= render(UI::Icon.new(name: "search", size: :sm)) %>
        <span class="hidden sm:inline">Search docs…</span>
      </span>
      <%= render(UI::Kbd.new("mod+k", size: :sm, class: "hidden sm:inline-flex")) %>
    <% end %>
    <% SearchIndex.entries.group_by(&:group).each do |group, entries| %>
      <% command.with_group(heading: group) do |section| %>
        <% entries.each do |entry| %>
          <%# The description is searched too, as words people might type. %>
          <% section.with_item(label: entry.title, href: entry.url, description: entry.description,
                               keywords: [ entry.keywords, entry.description ].compact.join(" ")) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>

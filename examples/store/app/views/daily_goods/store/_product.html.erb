<article>
  <div class="relative">
    <%= link_to product_path(product), tabindex: -1, "aria-hidden": true, class: "group block overflow-hidden rounded-3xl" do %>
      <%= image_tag product.image, alt: product.alt, loading: "lazy", class: "aspect-4/5 w-full object-cover transition-transform duration-300 group-hover:scale-[1.03] motion-reduce:transition-none" %>
    <% end %>
    <% unless product.in_stock %>
      <%= render(UI::Badge.new(variant: :secondary, class: "absolute top-3 left-3 rounded-full")) { "Sold out" } %>
    <% end %>
  </div>
  <div class="mt-3 flex items-baseline justify-between gap-2">
    <%= content_tag local_assigns.fetch(:heading, :h2), class: "truncate text-base font-medium sm:text-lg" do %><%= link_to product.name, product_path(product), class: "hover:underline hover:underline-offset-4" %><% end %>
    <p class="shrink-0 text-sm text-muted-foreground"><%= number_to_currency(product.price, precision: 0) %></p>
  </div>
  <%= render "daily_goods/store/cart_control", product: product %>
</article>

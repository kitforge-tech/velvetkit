<% if cart.empty? %>
  <div class="grid flex-1 place-content-center justify-items-center gap-3 py-24 text-center">
    <p class="font-medium">Your cart is empty.</p>
    <p class="text-sm text-muted-foreground">Add something from the shop to see it here.</p>
  </div>
<% else %>
  <ul class="-mx-1 grid flex-1 content-start gap-5 overflow-y-auto px-1">
    <% cart.lines.each do |line| %>
      <li class="flex gap-4">
        <%= image_tag line.product.image, alt: "", class: "size-20 shrink-0 rounded-2xl object-cover" %>
        <div class="flex min-w-0 flex-1 flex-col justify-between">
          <div class="flex items-start justify-between gap-2">
            <p class="truncate font-medium"><%= line.product.name %></p>
            <p class="text-sm tabular-nums"><%= number_to_currency(line.total, precision: 0) %></p>
          </div>
          <div class="flex items-center justify-between">
            <%= render "daily_goods/cart_items/quantity", product: line.product, quantity: line.quantity %>
            <%= button_to cart_item_path(line.product.slug), form: { data: { cart: true } }, method: :delete,
                          class: "grid size-8 place-items-center rounded-full text-muted-foreground hover:bg-accent hover:text-foreground",
                          "aria-label": "Remove #{line.product.name}" do %>
              <%= render(UI::Icon.new(name: "trash-2", class: "size-4")) %>
            <% end %>
          </div>
        </div>
      </li>
    <% end %>
  </ul>
  <div class="mt-6 grid gap-4 border-t pt-5">
    <div class="flex justify-between font-medium">
      <span>Subtotal</span>
      <span class="tabular-nums"><%= number_to_currency(cart.subtotal, precision: 0) %></span>
    </div>
    <p class="-mt-2 text-sm text-muted-foreground">Shipping and discount codes at checkout.</p>
    <%= render(UI::Button.new(size: :lg, class: "w-full rounded-full bg-foreground text-background hover:bg-foreground/85")) { "Checkout" } %>
  </div>
<% end %>

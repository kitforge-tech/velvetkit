<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= [ yield(:title).presence, "Daily Goods · a VelvetKit example" ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Daily Goods, an example shop built with VelvetKit components for Rails: filters, sorting and a cart, without a page reload.">
    <% if request.query_string.present? %><meta name="robots" content="noindex, follow"><% end %>
    <link rel="canonical" href="<%= ENV.fetch("SITE_URL", request.base_url) + request.path %>">
    <%= csrf_meta_tags %>
    <link rel="icon" href="data:,">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600&display=swap">
    <%= stylesheet_link_tag "daily_goods", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <%= javascript_include_tag "daily_goods/shop", "data-turbo-track": "reload", type: "module" %>
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <div class="bg-foreground text-background">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-1.5 text-xs">
        <p>An example shop built with VelvetKit. Nothing here is for sale.</p>
        <a href="<%= main_app.examples_path %>" class="shrink-0 underline underline-offset-4 hover:no-underline">Back to examples</a>
      </div>
    </div>
    <%= render "daily_goods/shared/header" %>
    <main><%= yield %></main>
    <%= render "daily_goods/shared/footer" %>
    <%= render(UI::Toast::Viewport.new) %>
  </body>
</html>

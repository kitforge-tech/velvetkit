<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= [ yield(:title).presence, "Helio · a VelvetKit example" ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Helio, an example dashboard built with VelvetKit components for Rails: charts, a data grid, a sidebar and more.">
    <% if request.query_string.present? %><meta name="robots" content="noindex, follow"><% end %>
    <link rel="canonical" href="<%= ENV.fetch("SITE_URL", request.base_url) + request.path %>">
    <%= csrf_meta_tags %>
    <link rel="icon" href="data:,">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
    <%= render "layouts/theme_script" %>
    <%= stylesheet_link_tag "helio", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <%= javascript_include_tag "helio/dashboard", "data-turbo-track": "reload", type: "module" %>
  </head>
  <body class="bg-background text-foreground">
    <div class="relative z-50 bg-slate-950 text-white">
      <div class="flex items-center justify-between gap-4 px-4 py-1.5 text-xs">
        <p>An example dashboard built with VelvetKit. The company and its numbers are made up.</p>
        <a href="<%= main_app.examples_path %>" class="shrink-0 underline underline-offset-4 hover:no-underline">Back to examples</a>
      </div>
    </div>

    <%# transform-gpu makes this the sidebar's containing block, so its fixed panel sits under the example strip. %>
    <div class="relative h-[calc(100svh-1.75rem)] transform-gpu">
      <%= render(UI::Sidebar::Wrapper.new(min_height: :full, class: "h-full")) do %>
        <%# `collapsible:` is the sidebar's current mode: :none is open, and the trigger
            switches it to :icon and back. Phones get the same links in a sheet instead. Its panel
            is a window tall; h-auto lets it fit under the example strip. %>
        <%= render(UI::Sidebar.new(id: "helio-sidebar", collapsible: :none,
                                     class: "max-md:hidden [&>[data-slot=sidebar-container]]:h-auto")) do |sidebar| %>
          <% sidebar.with_sidebar_header do %>
            <%= link_to root_path, class: "flex h-9 items-center gap-2 px-2 group-data-[collapsible=icon]:px-0" do %>
              <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-primary text-primary-foreground"><%= render(UI::Icon.new(name: "sun", class: "size-4")) %></span>
              <span class="font-semibold tracking-tight group-data-[collapsible=icon]:hidden">Helio</span>
            <% end %>
          <% end %>
          <% sidebar.with_sidebar_content do |content| %>
            <% nav_groups.each do |group_data| %>
              <% content.with_sidebar_group do |group| %>
                <% group.with_label(group_data[:label]) %>
                <% group.with_menu do |menu| %>
                  <% group_data[:items].each do |nav| %>
                    <% menu.with_menu_item do |item| %>
                      <% item.with_menu_button(nav[:href], active: current_page?(nav[:href]), title: nav[:text]) do %>
                        <%= render(UI::Icon.new(name: nav[:icon], size: :sm)) %>
                        <span><%= nav[:text] %></span>
                      <% end %>
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
          <% sidebar.with_sidebar_footer do %>
            <div class="flex items-center gap-2 rounded-md p-2 group-data-[collapsible=icon]:p-0">
              <%= render(UI::Avatar.new(size: :sm, color: :primary, alt: "Jordan Lee")) { |avatar| avatar.with_fallback { "JL" } } %>
              <div class="min-w-0 text-sm leading-tight group-data-[collapsible=icon]:hidden">
                <p class="truncate font-medium">Jordan Lee</p>
                <p class="truncate text-xs text-muted-foreground">jordan@helio.example</p>
              </div>
            </div>
          <% end %>
        <% end %>

        <%= render(UI::Sidebar::Inset.new(class: "min-w-0 overflow-y-auto")) do %>
          <header class="sticky top-0 z-30 flex h-14 shrink-0 items-center gap-2 border-b bg-background/90 px-4 backdrop-blur">
            <%= render(UI::Sidebar::Trigger.new(sidebar_id: "helio-sidebar", class: "max-md:hidden")) %>
            <%= render(UI::Sheet.new(class: "md:hidden")) do |sheet| %>
              <% sheet.with_trigger(variant: :ghost, size: :icon, class: "size-8", aria: { label: "Menu" }) { render(UI::Icon.new(name: "menu", class: "size-4")) } %>
              <% sheet.with_content(side: :left) do |content| %>
                <% content.with_title { "Helio" } %>
                <nav aria-label="Dashboard" class="grid gap-5">
                  <% nav_groups.each do |group| %>
                    <div class="grid gap-1">
                      <p class="px-2 text-xs font-medium text-muted-foreground"><%= group[:label] %></p>
                      <% group[:items].each do |nav| %>
                        <%= link_to nav[:href], class: "flex items-center gap-3 rounded-md px-2 py-2 text-sm hover:bg-accent aria-[current=page]:bg-primary/10 aria-[current=page]:font-semibold aria-[current=page]:text-primary",
                                                "aria-current": ("page" if current_page?(nav[:href])) do %>
                          <%= render(UI::Icon.new(name: nav[:icon], class: "size-4")) %><%= nav[:text] %>
                        <% end %>
                      <% end %>
                    </div>
                  <% end %>
                </nav>
              <% end %>
            <% end %>
            <span class="h-4 w-px bg-border" aria-hidden="true"></span>
            <p class="truncate text-sm font-medium"><%= yield(:title).presence || "Overview" %></p>
            <div class="ms-auto flex items-center gap-1">
              <%= render(UI::Command.new(dialog: true, shortcut: "mod+k", label: "Search", placeholder: "Search customers and pages", empty: "Nothing matches that.")) do |command| %>
                <% command.with_trigger(variant: :outline, class: "hidden h-8 w-56 justify-between text-muted-foreground sm:flex") do %>
                  <span class="flex items-center gap-2"><%= render(UI::Icon.new(name: "search", class: "size-4")) %>Search…</span>
                  <%= render(UI::Kbd.new) { "⌘K" } %>
                <% end %>
                <% command.with_group(heading: "Pages") do |group| %>
                  <% nav_groups.flat_map { |g| g[:items] }.each { |nav| group.with_item(label: nav[:text], href: nav[:href], icon: nav[:icon]) } %>
                <% end %>
                <% command.with_group(heading: "Customers") do |group| %>
                  <% Helio::Customer.all.first(8).each { |customer| group.with_item(label: customer.company, href: customers_path(q: customer.company)) } %>
                <% end %>
              <% end %>
              <%= render(UI::ThemeToggle.new) %>
            </div>
          </header>
          <main class="mx-auto w-full max-w-7xl p-4 sm:p-6"><%= yield %></main>
        <% end %>
      <% end %>
    </div>
    <%= render(UI::Toast::Viewport.new) %>
  </body>
</html>

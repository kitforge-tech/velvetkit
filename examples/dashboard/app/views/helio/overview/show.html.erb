<% content_for :title, "Overview" %>
<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight">Good morning, Jordan</h1>
    <p class="mt-1 text-sm text-muted-foreground">Here's how Helio is doing, up to <%= @metrics.today.strftime("%-d %B %Y") %>.</p>
  </div>
  <%= form_with url: root_path, method: :get, data: { auto_submit: true, turbo_action: "advance" } do %>
    <%= render(UI::ToggleGroup.new(name: "range", value: @range, label: "Period")) do |group| %>
      <% { "7d" => "7 days", "30d" => "30 days", "90d" => "90 days" }.each do |value, label| %>
        <% group.with_item(value: value, label: label, class: "px-3") %>
      <% end %>
    <% end %>
    <noscript><%= render(UI::Button.new(type: :submit, size: :sm, variant: :outline)) { "Show" } %></noscript>
  <% end %>
</div>

<%# The four numbers that matter, in one strip divided by rules. %>
<ul class="mt-6 grid grid-cols-2 rounded-xl border lg:grid-cols-4 [&>li]:p-4 sm:[&>li]:p-5 [&>li:nth-child(odd)]:border-e lg:[&>li]:border-e lg:[&>li:last-child]:border-e-0 max-lg:[&>li:nth-child(-n+2)]:border-b">
  <% @metrics.tiles.each do |tile| %>
    <% text, good = change(tile[:value], tile[:before], lower_is_better: tile[:lower_is_better]) %>
    <li>
      <p class="text-sm text-muted-foreground"><%= tile[:label] %></p>
      <p class="mt-1 text-2xl font-semibold tracking-tight tabular-nums sm:text-3xl"><%= tile[:format] == :currency ? money(tile[:value]) : number_with_delimiter(tile[:value]) %></p>
      <p class="mt-1 flex flex-wrap items-center gap-1.5 text-xs text-muted-foreground">
        <span class="inline-flex items-center gap-0.5 font-medium <%= good ? "text-emerald-700 dark:text-emerald-400" : "text-rose-700 dark:text-rose-400" %>">
          <%= render(UI::Icon.new(name: tile[:value] >= tile[:before] ? "trending-up" : "trending-down", class: "size-3")) %><%= text %>
        </span>
        <%= tile[:flow] ? "vs previous #{@metrics.days} days" : "vs #{@metrics.days} days ago" %>
      </p>
    </li>
  <% end %>
</ul>

<section aria-labelledby="revenue-heading" class="mt-10">
  <div class="mb-4 flex items-baseline justify-between gap-4">
    <div>
      <h2 id="revenue-heading" class="font-semibold">Monthly revenue</h2>
      <p class="text-sm text-muted-foreground">Recurring revenue at the end of each month, last 12 months</p>
    </div>
  </div>
  <% revenue = @metrics.revenue_by_month %>
  <%= render(UI::Chart.new(type: :line, label: "Monthly recurring revenue", format: :currency, precision: 0, show_data: false,
                           labels: revenue[:labels], series: [ { name: "Revenue", data: revenue[:data] } ], height: 260)) %>
</section>

<div class="mt-10 grid gap-10 border-t pt-8 lg:grid-cols-5">
  <section aria-labelledby="plans-heading" class="lg:col-span-2">
    <h2 id="plans-heading" class="font-semibold">Revenue by plan</h2>
    <p class="mb-4 text-sm text-muted-foreground">This month</p>
    <% plans = @metrics.revenue_by_plan %>
    <%= render(UI::Chart.new(type: :donut, label: "Revenue by plan", format: :currency, precision: 0, show_data: false,
                             labels: plans[:labels], series: [ { name: "Revenue", data: plans[:data] } ], height: 200)) %>
  </section>
  <section aria-labelledby="signups-heading" class="lg:col-span-3">
    <h2 id="signups-heading" class="font-semibold">New sign-ups</h2>
    <p class="mb-4 text-sm text-muted-foreground">Last <%= @metrics.days %> days<%= ", by week" if @metrics.days > 30 %></p>
    <% signups = @metrics.signups_over_period %>
    <%= render(UI::Chart.new(type: :bar, label: "New sign-ups", show_data: false, labels: signups[:labels],
                             series: [ { name: "Sign-ups", data: signups[:data] } ], height: 220)) %>
  </section>
</div>

<div class="mt-10 grid gap-10 border-t pt-8 lg:grid-cols-5">
  <section aria-labelledby="attention-heading" class="lg:col-span-3">
    <div class="mb-3 flex items-baseline justify-between gap-4">
      <div>
        <h2 id="attention-heading" class="font-semibold">Needs attention</h2>
        <p class="text-sm text-muted-foreground">Failed payments, and trials ending this week</p>
      </div>
      <%= link_to "View all", customers_path(view: "past_due"), class: "text-sm font-medium text-primary hover:underline hover:underline-offset-4" %>
    </div>
    <% items = @metrics.needs_attention(workspace) %>
    <% if items.any? %>
      <ul class="divide-y rounded-xl border">
        <% items.each do |item| %>
          <% customer = item[:customer] %>
          <li>
            <%= link_to customer_path(customer), class: "flex items-center gap-3 px-4 py-3 hover:bg-muted/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring" do %>
              <%= render(UI::Avatar.new(size: :md, alt: customer.contact)) { |avatar| avatar.with_fallback { customer.initials } } %>
              <span class="min-w-0 flex-1">
                <span class="block truncate text-sm font-medium"><%= customer.company %></span>
                <span class="block truncate text-xs text-muted-foreground"><%= customer.plan %>, <%= pluralize(customer.seats, "seat") %> · <%= money(customer.list_price) %>/mo</span>
              </span>
              <span class="shrink-0 rounded-full px-2 py-0.5 text-xs font-medium <%= item[:tone] == :error ? "bg-rose-500/10 text-rose-700 dark:text-rose-400" : "bg-amber-500/10 text-amber-700 dark:text-amber-400" %>"><%= item[:reason] %></span>
              <%= render(UI::Icon.new(name: "chevron-right", class: "size-4 shrink-0 text-muted-foreground")) %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <%= render(UI::EmptyState.new(icon: "circle-check", title: "All clear", description: "No failed payments, and no trials ending this week.", variant: :outline, heading_level: 3)) %>
    <% end %>
  </section>

  <section aria-labelledby="activity-heading" class="lg:col-span-2">
    <h2 id="activity-heading" class="mb-4 font-semibold">Recent activity</h2>
    <%= render(UI::Timeline.new(label: "Recent activity")) do |timeline| %>
      <% @metrics.activity.each do |event| %>
        <% customer = event[:customer] %>
        <% title, icon, status = case event[:kind]
             when :signup then [ "#{customer.company} started a trial", "user-plus", :complete ]
             when :cancelled then [ "#{customer.company} cancelled", "user-minus", :error ]
             else [ "Payment failed for #{customer.company}", "credit-card", :error ]
             end %>
        <% timeline.with_item(title: title, description: "#{customer.plan}, #{pluralize(customer.seats, 'seat')}", icon: icon, status: status,
                              time: event[:date].to_time, time_label: event[:date] == @metrics.today ? "Today" : "#{(@metrics.today - event[:date]).to_i}d ago") %>
      <% end %>
    <% end %>
  </section>
</div>

<section aria-labelledby="top-heading" class="mt-10 border-t pt-8">
  <div class="mb-4 flex items-baseline justify-between gap-4">
    <div>
      <h2 id="top-heading" class="font-semibold">Top customers</h2>
      <p class="text-sm text-muted-foreground">By monthly revenue</p>
    </div>
    <%= link_to "View all", customers_path, class: "text-sm font-medium text-primary hover:underline hover:underline-offset-4" %>
  </div>
  <%= render(UI::Table.new("aria-label": "Top customers by monthly revenue")) do |table| %>
    <% table.with_head do |head| %>
      <% head.with_column { "Customer" } %>
      <% head.with_column { "Plan" } %>
      <% head.with_column(class: "hidden sm:table-cell", align: :end) { "Seats" } %>
      <% head.with_column(class: "hidden sm:table-cell") { "Country" } %>
      <% head.with_column(align: :end) { "Monthly" } %>
    <% end %>
    <% @metrics.top_customers.each do |customer| %>
      <% table.with_row do |row| %>
        <% row.with_cell do %>
          <div class="flex items-center gap-3">
            <%= render(UI::Avatar.new(size: :md, alt: customer.contact)) { |avatar| avatar.with_fallback { customer.initials } } %>
            <div class="min-w-0">
              <%= link_to customer.company, customer_path(customer), class: "block truncate font-medium hover:underline hover:underline-offset-4" %>
              <p class="truncate text-xs text-muted-foreground"><%= customer.contact %></p>
            </div>
          </div>
        <% end %>
        <% row.with_cell { customer.plan } %>
        <% row.with_cell(align: :end, class: "hidden tabular-nums sm:table-cell") { customer.seats.to_s } %>
        <% row.with_cell(class: "hidden sm:table-cell") { customer.country } %>
        <% row.with_cell(align: :end, class: "font-medium tabular-nums") { money(customer.mrr) } %>
      <% end %>
    <% end %>
  <% end %>
</section>

<% binned = library.binned?(photo) %>
<%= button_to selection_path, params: { do: binned ? "restore" : "bin", "ids[]": photo.id }, form: { class: "contents" },
      class: "inline-flex size-9 items-center justify-center rounded-full border border-white/25 bg-black/60 text-white hover:bg-black/80 focus:outline-none focus-visible:ring-2 focus-visible:ring-white",
      aria: { label: binned ? "Restore #{photo.title}" : "Move #{photo.title} to the bin" } do %>
  <%= render(UI::Icon.new(name: binned ? "rotate-ccw" : "trash-2", class: "size-4")) %>
<% end %>

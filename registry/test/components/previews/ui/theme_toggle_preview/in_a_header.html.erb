<%# Mirrors the real app header: sidebar trigger left, theme toggle right. %>
<div class="rounded-lg border overflow-hidden">
  <header class="flex border-b h-14 shrink-0 items-center gap-2">
    <div class="flex items-center gap-2 px-2">
      <%= render(UI::Sidebar::Trigger.new(sidebar_id: "preview-sidebar")) %>
    </div>
    <div class="ml-auto flex items-center gap-2 px-2">
      <%= render(UI::ThemeToggle.new) %>
    </div>
  </header>
  <div class="p-6">
    <%= render(UI::Text.new) { "Switch the theme with the control above — the whole page follows." } %>
  </div>
</div>

<div class="space-y-6">
  <div>
    <h3 class="text-sm font-medium mb-2 text-muted-foreground">Disabled</h3>
    <%= render(UI::RadioGroup.new(name: "disabled_plan", disabled: true)) do |rg| %>
      <% rg.with_item(value: "free", label: "Free plan") %>
      <% rg.with_item(value: "pro", label: "Pro plan (selected)", checked: true) %>
    <% end %>
  </div>
  <div>
    <h3 class="text-sm font-medium mb-2 text-muted-foreground">Individual item disabled</h3>
    <%= render(UI::RadioGroup.new(name: "partial_disabled", value: "free")) do |rg| %>
      <% rg.with_item(value: "free", label: "Free plan") %>
      <% rg.with_item(value: "pro", label: "Pro plan (unavailable)", disabled: true) %>
      <% rg.with_item(value: "enterprise", label: "Enterprise") %>
    <% end %>
  </div>
</div>

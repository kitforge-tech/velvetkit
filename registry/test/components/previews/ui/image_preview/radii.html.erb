<div class="flex flex-wrap gap-6">
  <% %i[none xs sm md lg xl full].each do |r| %>
    <div class="flex flex-col items-center gap-2">
      <%= render(UI::Image.new(src: UI::ImagePreview.photo, alt: "Mountains at sunset", rounded: r, width: "96px", height: "96px")) %>
      <span class="text-xs text-muted-foreground"><%= r %></span>
    </div>
  <% end %>
</div>

<div class="flex flex-wrap gap-12 p-8 border rounded-lg bg-muted/30 items-center justify-center">
  <div class="text-center">
    <p class="text-xs text-muted-foreground mb-2">bottom-start</p>
    <%= render(UI::Menu.new) do |menu| %>
      <% menu.with_trigger { "Open" } %>
      <% menu.with_content(side: :bottom, align: :start) do |content| %>

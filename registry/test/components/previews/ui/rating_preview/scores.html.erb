<%# Shown to the nearest half star. A screen reader hears one image, "Rated 4.5 out of 5", and the count.
    The last is a field to choose one: `show_value: true` keeps the score beside it to the one chosen, and
    it resets with the form. The reset button is only here to try it again. %>
<div class="flex flex-col gap-3">
  <%= render(UI::Rating.new(value: 5, show_value: true, count: 2_481)) %>
  <%= render(UI::Rating.new(value: 4.5, show_value: true, count: 312)) %>
  <%= render(UI::Rating.new(value: 3.7, show_value: true, count: 46)) %>
  <%= render(UI::Rating.new(value: 2, show_value: true, count: 1)) %>
  <%= render(UI::Rating.new(value: nil, show_value: true, count: 0)) %>
  <form action="#" onsubmit="event.preventDefault()" class="flex items-center gap-2">
    <%= render(UI::Rating.new(name: "rating", show_value: true)) %>
    <button type="reset" title="Start again" aria-label="Start again"
            class="rounded-sm text-muted-foreground transition-colors hover:text-foreground focus:outline-none focus-visible:ring-2 focus-visible:ring-primary">
      <%# Not one of the kit's controls, so only the icon: a ring only from the keyboard. %>
      <%= render(UI::Icon.new(name: "rotate-cw", size: :sm)) %>
    </button>
  </form>
</div>

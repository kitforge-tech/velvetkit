<%# In an app, @review comes back from a failed save. Bound, the field shows its errors on its own,
    and choosing a score clears them; `thanks: true` then says thank you. Resetting the form brings
    the errors back: the reset button is only here to try it again. The messages are kept from
    widening the field, so the button stays beside the stars. %>
<% review = Struct.new(:rating, :delivery) do
     include ActiveModel::Validations
     def self.model_name = ActiveModel::Name.new(self, nil, "Review")
     validates :rating, presence: true
   end.new(nil, 4).tap(&:validate) %>
<%= form_with(model: review, url: "#", class: "flex max-w-sm flex-col gap-6") do |f| %>
  <div class="flex items-center gap-2 [&_fieldset>p]:w-0 [&_fieldset>p]:whitespace-nowrap">
    <%= render(UI::Rating.new(form: f, field: :rating, legend: true, required: true, thanks: true)) %>
    <button type="reset" title="Start again" aria-label="Start again"
            class="rounded-sm text-muted-foreground transition-colors hover:text-foreground focus:outline-none focus-visible:ring-2 focus-visible:ring-primary">
      <%# Not one of the kit's controls, so only the icon: a ring only from the keyboard. %>
      <%= render(UI::Icon.new(name: "rotate-cw", size: :sm)) %>
    </button>
  </div>
  <%= render(UI::Rating.new(form: f, field: :delivery, legend: "Delivery", hint: "Was it on time and well packed?")) %>
<% end %>

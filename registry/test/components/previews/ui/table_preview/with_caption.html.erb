<%= render(UI::Table.new(caption: "Grade 8 B — 3 students")) do |table| %>
  <% table.with_head do |head| %>
    <% head.with_column { "Name" } %>
    <% head.with_column(align: :end) { "Attendance" } %>
  <% end %>
  <% table.with_row(selected: true) do |row| %>
    <% row.with_cell { "Aditi Rao" } %>
    <% row.with_cell(align: :end) { "96%" } %>
  <% end %>
  <% table.with_row do |row| %>
    <% row.with_cell { "Arjun Nair" } %>
    <% row.with_cell(align: :end) { "88%" } %>
  <% end %>
<% end %>

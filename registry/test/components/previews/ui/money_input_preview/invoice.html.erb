<%# Reads the hidden fields, which hold plain numbers, so there's no comma or full stop to strip. %>
<div id="money-invoice-demo" class="grid max-w-sm gap-4">
  <%= render(UI::MoneyInput.new(name: "fee", unit: "€", separator: ",", delimiter: ".", value: 8500, label: "Design work")) %>
  <%= render(UI::MoneyInput.new(name: "expenses", unit: "€", separator: ",", delimiter: ".", value: 1245.75, label: "Expenses",
                                hint: "Travel and printing, at cost.")) %>
  <dl class="grid grid-cols-2 gap-y-1 border-t pt-3 text-sm">
    <dt class="text-muted-foreground">VAT at 20% on the work</dt><dd class="text-end tabular-nums" data-demo="vat"></dd>
    <dt class="font-medium">Total</dt><dd class="text-end font-medium tabular-nums" data-demo="total"></dd>
  </dl>
</div>
<script>
  (() => {
    const root = document.getElementById("money-invoice-demo");
    const money = (n) => "€" + n.toLocaleString("de-DE", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const amount = (name) => Number(root.querySelector(`input[type=hidden][name="${name}"]`).value || 0);
    const total = () => {
      const vat = amount("fee") * 0.2;
      root.querySelector('[data-demo="vat"]').textContent = money(vat);
      root.querySelector('[data-demo="total"]').textContent = money(amount("fee") + amount("expenses") + vat);
    };
    root.addEventListener("input", total);
    total();
  })();
</script>

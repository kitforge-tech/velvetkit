<%# The VelvetKit logo for the sidebar header: the full logo while expanded,
    the V mark once collapsed to icons. The images are velvetkit.com's; in an
    app, put its own logo here. %>
<div class="flex h-9 items-center px-2">
  <span class="group-data-[collapsible=icon]:hidden">
    <img src="/velvetkit/logo-light.png" alt="VelvetKit" class="h-8 w-auto dark:hidden">
    <img src="/velvetkit/logo-dark.png" alt="VelvetKit" class="hidden h-8 w-auto dark:block">
  </span>
  <span class="hidden group-data-[collapsible=icon]:block">
    <img src="/velvetkit/mark-light.png" alt="VelvetKit" class="size-7 dark:hidden">
    <img src="/velvetkit/mark-dark.png" alt="VelvetKit" class="hidden size-7 dark:block">
  </span>
</div>

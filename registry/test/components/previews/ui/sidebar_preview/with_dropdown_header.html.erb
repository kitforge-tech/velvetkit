<% brand = capture do %>
  <%= render(UI::Menu.new) do |menu| %>
    <% menu.with_trigger(variant: :ghost, class: "w-full justify-start px-2 h-auto py-1.5") do %>
      <div class="flex h-8 w-8 items-center justify-center rounded bg-primary/10 text-primary text-xs font-bold shrink-0">NO</div>
      <div class="grid flex-1 text-left text-sm leading-tight group-data-[collapsible=icon]:hidden">
        <span class="truncate font-medium">New Oxford</span>
        <span class="truncate text-xs text-muted-foreground">School</span>
      </div>
      <%= render(UI::Icon.new(name: "chevrons-up-down", size: :sm, class: "ml-auto group-data-[collapsible=icon]:hidden")) %>
    <% end %>
    <% menu.with_content(side: :right, align: :start, class: "w-56") do |content| %>
      <% content.with_label("Institutes") %>
      <% content.with_item("New Oxford School") %>
      <% content.with_item("Cambridge Academy") %>
      <% content.with_item("Harvard Prep") %>
    <% end %>
  <% end %>
<% end %>

<% main = capture do %>
  <p class="text-muted-foreground">Sidebar with a dropdown menu inside the header for context switching.</p>
<% end %>

<%= render "ui/sidebar_preview/shell",
      sidebar_id: "preview-sidebar-dropdown",
      brand: brand,
      main: main,
      groups: [
        { label: "Applications", items: [
          { icon: "layout-dashboard", text: "Dashboard", active: true, icon_class: "stroke-orange-500" },
          { icon: "users",            text: "Students",                icon_class: "stroke-purple-500" }
        ] }
      ] %>

<% brand = capture do %>
  <%= render(UI::Menu.new) do |menu| %>
    <% menu.with_trigger(variant: :ghost, class: "w-full justify-start px-2 h-auto py-1.5 group-data-[collapsible=icon]:size-8 group-data-[collapsible=icon]:justify-center group-data-[collapsible=icon]:p-0") do %>
      <img src="/velvetkit/mark-light.svg" alt="" class="size-8 max-w-none shrink-0 object-contain dark:hidden"><img src="/velvetkit/mark-dark.svg" alt="" class="hidden size-8 max-w-none shrink-0 object-contain dark:block">
      <div class="grid flex-1 text-left text-sm leading-tight group-data-[collapsible=icon]:hidden">
        <span class="truncate font-medium">VelvetKit</span>
        <span class="truncate text-xs text-muted-foreground">Workspace</span>
      </div>
      <%= render(UI::Icon.new(name: "chevrons-up-down", size: :sm, class: "ml-auto group-data-[collapsible=icon]:hidden")) %>
    <% end %>
    <% menu.with_content(side: :right, align: :start, class: "w-56") do |content| %>
      <% content.with_label("Workspaces") %>
      <% content.with_item("VelvetKit") %>
      <% content.with_item("Marketing site") %>
      <% content.with_item("Internal tools") %>
    <% end %>
  <% end %>
<% end %>

<% main = capture do %>
  <p class="text-muted-foreground">Sidebar with a dropdown menu inside the header for context switching.</p>
<% end %>

<%= render "ui/sidebar_preview/shell",
      sidebar_id: "preview-sidebar-dropdown",
      brand: brand,
      main: main,
      groups: [
        { label: "Applications", items: [
          { icon: "layout-dashboard", text: "Dashboard", active: true, icon_class: "stroke-orange-500" },
          { icon: "users",            text: "Team",                icon_class: "stroke-purple-500" }
        ] }
      ] %>

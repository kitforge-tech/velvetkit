<%= render(UI::Card.new(class: "max-w-md")) do |card| %>
  <% card.with_header do |header| %>
    <% header.with_title { "Team" } %>
    <% header.with_description { "Who can see this project." } %>
    <% header.with_action { render(UI::Button.new(variant: :outline, size: :sm)) { "Invite" } } %>
  <% end %>
  <% card.with_content do %>
    <ul class="grid gap-3">
      <% [ [ "Maya Okafor", "maya@example.com", "Owner" ], [ "Tomás Reyes", "tomas@example.com", "Editor" ], [ "Li Wei", "li@example.com", "Viewer" ] ].each do |name, email, role| %>
        <li class="flex items-center gap-3">
          <%= render(UI::Avatar.new) { name.split.map(&:first).join } %>
          <div class="min-w-0 flex-1">
            <p class="truncate font-medium"><%= name %></p>
            <p class="truncate text-muted-foreground"><%= email %></p>
          </div>
          <%= render(UI::Badge.new(variant: :secondary, size: :sm)) { role } %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>

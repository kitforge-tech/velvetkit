<div class="max-w-sm">
  <%= render(UI::Card.new) do |card| %>
    <% card.with_header do |header| %>
      <% header.with_title { "Team Members" } %>
      <% header.with_description { "Manage your team and permissions." } %>
    <% end %>
    <% card.with_content do %>
      <div class="space-y-3">
        <div class="flex items-center gap-3">
          <div class="h-8 w-8 rounded-full bg-primary/10 flex items-center justify-center text-xs font-medium text-primary">JD</div>
          <div>
            <p class="text-sm font-medium">John Doe</p>
            <p class="text-xs text-muted-foreground">Admin</p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <div class="h-8 w-8 rounded-full bg-primary/10 flex items-center justify-center text-xs font-medium text-primary">AS</div>
          <div>
            <p class="text-sm font-medium">Alice Smith</p>
            <p class="text-xs text-muted-foreground">Editor</p>
          </div>
        </div>
      </div>
    <% end %>
    <% card.with_footer do %>
      <div class="flex gap-2 w-full">
        <%= render(UI::Button.new(variant: :outline, size: :sm, class: "w-full")) { "Invite Member" } %>
      </div>
    <% end %>
  <% end %>
</div>

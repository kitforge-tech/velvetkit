<%= render(UI::Card.new(class: "max-w-md")) do |card| %>
  <% card.with_header(class: "border-b") do |header| %>
    <% header.with_title { "Profile" } %>
    <% header.with_description { "This is how others see you." } %>
  <% end %>
  <% card.with_content do %>
    <div class="grid gap-4">
      <%= render(UI::Input.new(name: "display_name", label: "Display name", value: "Maya Okafor")) %>
      <%= render(UI::Input.new(name: "username", label: "Username", value: "maya", hint: "Letters and numbers only.")) %>
    </div>
  <% end %>
  <% card.with_footer(class: "justify-between") do %>
    <span class="text-muted-foreground">Last saved 2 days ago</span>
    <%= render(UI::Button.new(size: :sm)) { "Save" } %>
  <% end %>
<% end %>

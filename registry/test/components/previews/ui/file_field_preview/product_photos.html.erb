<%# Each photo uploads as soon as it's chosen, with a progress bar, and the form
    sends only the uploaded photos' ids. Saving while a photo is still on its
    way waits for it, then saves. The two already on the product show as tiles;
    take one out and save, and it's gone. Bound to a form, those come from the
    record: render(UI::FileField.new(form: f, field: :photos, ...)). %>
<form action="/demo/products/1" method="post" class="flex max-w-xl flex-col items-start gap-4">
  <input type="hidden" name="_method" value="patch">
  <%= render(UI::FileField.new(name: "product[photos][]", label: "Photos", hint: "PNG or JPG, up to 5 MB each",
                               multiple: true, accept: "image/*", max_size: 5.megabytes, direct_upload: true,
                               existing: UI::FileFieldPreview.kept_photos)) %>
  <%= render(UI::Button.new(type: :submit)) { "Save product" } %>
</form>

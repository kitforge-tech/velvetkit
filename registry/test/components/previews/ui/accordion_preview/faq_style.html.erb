<div class="max-w-lg">
  <h2 class="text-xl font-semibold mb-4">Frequently Asked Questions</h2>
  <%= render(UI::Accordion.new(type: :single)) do |accordion| %>
    <% faqs = [
      { q: "How do I reset my password?", a: "Go to Settings &gt; Security and click 'Change Password'. You'll need to enter your current password and your new password." },
      { q: "Can I import data from another system?", a: "Yes, Northwind supports CSV and JSON imports. Go to Admin &gt; Data Import and follow the wizard to map your fields." },
      { q: "What integrations are available?", a: "We integrate with Google Classroom, Microsoft Teams, Canvas, Moodle, and many more through our API." },
      { q: "Is there a mobile app?", a: "Yes! Northwind is available on iOS and Android. Download from the App Store or Google Play." },
      { q: "How do I contact support?", a: 'Email us at support@example.com or use the live chat widget in the bottom-right corner of your dashboard.' }
    ] %>
    <% faqs.each_with_index do |faq, i| %>
      <% accordion.with_item(value: "faq-#{i}") do |item| %>
        <% item.with_trigger { faq[:q] } %>
        <% item.with_content do %>
          <p class="text-muted-foreground"><%= faq[:a].html_safe %></p>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>

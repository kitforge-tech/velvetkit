<% today = Date.current %>
<%= render(UI::DateRangePicker.new(label: "Financial year", class: "max-w-sm", presets: [
      [ "This quarter", today.beginning_of_quarter, today ],
      [ "Last quarter", today.prev_quarter.beginning_of_quarter, today.prev_quarter.end_of_quarter ],
      [ "This financial year", Date.new(today.month >= 4 ? today.year : today.year - 1, 4, 1), today ]
    ])) %>

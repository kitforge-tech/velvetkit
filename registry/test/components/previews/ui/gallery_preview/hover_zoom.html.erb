<div class="grid max-w-3xl gap-8 sm:grid-cols-2">
  <%= render(UI::Gallery.new(label: "Photos of the ceramic mug", zoom: :hover)) do |gallery| %>
    <% UI::GalleryPreview.photos.each do |title, src| %>
      <% gallery.with_image(src: src, alt: "Ceramic mug: #{title}") %>
    <% end %>
  <% end %>
  <div class="space-y-3">
    <h2 class="text-xl font-semibold">Ceramic mug</h2>
    <p class="text-lg">$14.00</p>
    <p class="text-sm text-muted-foreground">Hand-glazed stoneware that holds 350 ml. Move your mouse over the photo to magnify it, or click to open the overlay.</p>
    <%= render(UI::Button.new) { "Add to cart" } %>
  </div>
</div>

<div class="grid grid-cols-[1fr_12rem] gap-8 max-w-2xl">
  <div id="toc-flat-article" class="h-72 overflow-y-auto rounded-md border p-6 space-y-6 [&>section:last-child]:min-h-60">
    <% %w[Install Configure Theme Deploy].each do |heading| %>
      <section class="space-y-2">
        <h2 id="toc-flat-<%= heading.downcase %>" class="font-semibold"><%= heading %></h2>
        <p class="text-sm text-muted-foreground">Each section starts with what you need and ends with how to check it worked.</p>
        <p class="text-sm text-muted-foreground">Commands run from the root of your Rails app.</p>
      </section>
    <% end %>
  </div>

  <%= render(UI::TableOfContents.new(container: "#toc-flat-article", offset: 24)) do |toc| %>
    <% %w[Install Configure Theme Deploy].each do |heading| %>
      <% toc.with_item(href: "#toc-flat-#{heading.downcase}", text: heading) %>
    <% end %>
  <% end %>
</div>

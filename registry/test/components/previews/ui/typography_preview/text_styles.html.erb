<div class="max-w-xl space-y-4">
  <%= render(UI::Typography::Lead.new) { "Lead: an introduction that sets up the page in a sentence or two." } %>
  <%= render(UI::Typography::Large.new) { "Large: a line that needs a little more weight." } %>
  <%= render(UI::Text.new) { "Body text, for most of what a page says." } %>
  <%= render(UI::Typography::Muted.new) { "Muted: secondary detail, like a caption or a hint." } %>
  <%= render(UI::Typography::Small.new) { "Small: a label or fine print." } %>
</div>

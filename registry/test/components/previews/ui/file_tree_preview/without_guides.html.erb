<%= render(UI::FileTree.new(label: "Project files", guides: false, class: "max-w-xs")) do |tree| %>
  <% tree.with_folder(name: "app", open: true) do |app| %>
    <% app.with_folder(name: "views", open: true) do |views| %>
      <% views.with_file(name: "index.html.erb", value: "app/views/index.html.erb") %>
      <% views.with_file(name: "show.html.erb", value: "app/views/show.html.erb", active: true) %>
    <% end %>
    <% app.with_file(name: "application.rb", value: "app/application.rb") %>
  <% end %>
  <% tree.with_file(name: "Gemfile", value: "Gemfile") %>
<% end %>

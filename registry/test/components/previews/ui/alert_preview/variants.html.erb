<div class="flex flex-col gap-4 max-w-lg">
  <%= render(UI::Alert.new) do |alert| %>
    <% alert.with_title { "Default" } %>
    <% alert.with_description { "This is a default alert with important information." } %>
  <% end %>
  <%= render(UI::Alert.new(variant: :success)) do |alert| %>
    <% alert.with_title { "Success" } %>
    <% alert.with_description { "Your changes have been saved successfully." } %>
  <% end %>
  <%= render(UI::Alert.new(variant: :destructive)) do |alert| %>
    <% alert.with_title { "Destructive" } %>
    <% alert.with_description { "There was a problem with your request." } %>
  <% end %>
  <%= render(UI::Alert.new(variant: :warning)) do |alert| %>
    <% alert.with_title { "Warning" } %>
    <% alert.with_description { "This action cannot be undone." } %>
  <% end %>
  <%= render(UI::Alert.new(variant: :info)) do |alert| %>
    <% alert.with_title { "Info" } %>
    <% alert.with_description { "Here's some helpful information." } %>
  <% end %>
</div>

<div class="max-w-lg">
  <%= render(UI::Tabs.new(default_value: "account")) do |tabs| %>
    <% tabs.with_list do |list| %>
      <% list.with_trigger(value: "account") { "Account" } %>
      <% list.with_trigger(value: "password") { "Password" } %>
      <% list.with_trigger(value: "team") { "Team" } %>
      <% list.with_trigger(value: "billing", disabled: true) { "Billing" } %>
    <% end %>
    <% tabs.with_panel(value: "account") do %>
      <div class="space-y-4">
        <p class="text-sm text-muted-foreground">Manage your account settings and preferences.</p>
        <div class="p-4 border rounded-md">
          <p class="text-sm">Account content goes here.</p>
        </div>
      </div>
    <% end %>
    <% tabs.with_panel(value: "password") do %>
      <div class="space-y-4">
        <p class="text-sm text-muted-foreground">Update your password and security settings.</p>
        <div class="p-4 border rounded-md">
          <p class="text-sm">Password content goes here.</p>
        </div>
      </div>
    <% end %>
    <% tabs.with_panel(value: "team") do %>
      <div class="space-y-4">
        <p class="text-sm text-muted-foreground">Manage team members and permissions.</p>
        <div class="p-4 border rounded-md">
          <p class="text-sm">Team content goes here.</p>
        </div>
      </div>
    <% end %>
    <% tabs.with_panel(value: "billing") do %>
      <div class="space-y-4">
        <p class="text-sm text-muted-foreground">View and manage billing information.</p>
      </div>
    <% end %>
  <% end %>
</div>

<%= tag.li(**item_attrs) do %>
  <%= tag.div class: head_classes do %>
    <%= tag.span class: indicator_classes, aria: { hidden: true } do %>
      <% unless dot? %>
        <%= tag.span number_glyph, class: glyph_classes(:number) %>
        <%= tag.span render(UI::Icon.new(name: "check", size: :sm)), class: glyph_classes(:complete) %>
        <%= tag.span "!", class: glyph_classes(:error) + " font-bold" %>
        <%= tag.span render(UI::Icon.new(name: "loader", size: :sm, class: "animate-spin")), class: glyph_classes(:loading) %>
      <% end %>
    <% end %>
    <% if connector? %>
      <%= tag.span class: connector_classes, aria: { hidden: true } do %><%= tag.span class: connector_fill_classes %><% end %>
    <% end %>
  <% end %>
  <%= tag.div class: text_classes do %>
    <% if link? %>
      <%= link_to @href, class: link_classes do %><%= tag.span @title, id: title_id, class: title_classes %><% end %>
    <% else %>
      <%= tag.span @title, id: title_id, class: title_classes %>
    <% end %>
    <% if description? %><%= tag.span @description, class: description_classes %><% end %>
    <% status_texts.each do |text, classes| %><%= tag.span ", #{text}", class: classes %><% end %>
    <% if inline_panel? %><%= tag.div(panel, **panel_attrs) %><% end %>
  <% end %>
<% end %>

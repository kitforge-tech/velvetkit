<%# frozen_string_literal: true %>
<%= tag.div(**root_attrs) do %>
  <% if header? %>
    <div class="flex items-baseline justify-between gap-3 text-sm">
      <% if label.present? %><span id="<%= label_id %>" class="font-medium text-foreground"><%= label %></span><% end %>
      <span class="<%= cn("ms-auto text-muted-foreground tabular-nums", ("hidden" unless show_value?)) %>" data-ui--progress-target="text" aria-hidden="true"><%= value_text %></span>
    </div>
  <% end %>
  <%= tag.div(**bar_attrs) do %>
    <%= tag.div(**indicator_attrs) do %>
      <% segments.each_with_index do |segment, index| %><%= tag.div(**segment_attrs(segment, index)) %><% end %>
    <% end %>
  <% end %>
  <% if legend? %>
    <ul class="flex flex-wrap gap-x-4 gap-y-1 pt-1 text-sm" data-slot="progress-legend">
      <% segments.each_with_index do |segment, index| %>
        <li class="flex items-center gap-1.5">
          <span class="<%= cn("size-2 shrink-0 rounded-full", swatch(segment, index), segment.user_class) %>" aria-hidden="true"></span>
          <span class="text-foreground"><%= segment.label %></span>
          <span class="text-muted-foreground tabular-nums"><%= segment_text(segment) %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>

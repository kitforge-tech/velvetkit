<%= render(wrapper) do %><%= tag.div class: card_classes, data: root_data do %>
  <%= tag.label for: @input_id, class: dropzone_classes, data: { "ui--file-field-target": "dropzone" } do %>
    <span class="flex size-10 items-center justify-center rounded-full border bg-background text-muted-foreground shadow-sm" aria-hidden="true">
      <%= render(UI::Icon.new(name: "upload", size: :sm)) %>
    </span>
    <span class="flex flex-col gap-1">
      <span class="text-sm"><span class="font-medium text-primary dark:text-foreground"><%= t("ui.file_field.browse", default: "Click to upload") %></span> <span class="text-muted-foreground"><%= t("ui.file_field.drop", default: "or drag and drop") %></span></span>
      <% if requirements %><%= tag.span requirements, id: requirements_id, class: "text-xs text-muted-foreground" %><% end %>
    </span>
    <% unless preview? %><span class="text-xs font-medium text-foreground empty:hidden" data-ui--file-field-target="filenames"></span><% end %>
    <% if form_field? %><%= @form.file_field(@field, **form_field_options) %><% else %><%= tag.input(**html_options) %><% end %>
  <% end %>
  <% if preview? %>
    <%= tag.ul class: "flex flex-col gap-2 pt-2 empty:hidden", data: { "ui--file-field-target": "list" } do %><% existing_files.each do |file| %><%= tile(**file) %><% end %><% end %>
    <template data-ui--file-field-target="template"><%= tile(state: "chosen") %></template>
    <p class="px-1 pt-2 text-xs text-muted-foreground empty:hidden" data-ui--file-field-target="notice"></p>
    <p class="sr-only" aria-live="polite" data-ui--file-field-target="status"></p>
  <% end %>
<% end %><% end %>

<%= tag.details(**details_options) do %>
  <%= tag.summary(class: trigger_classes) do %>
    <span class="min-w-0 flex-1 truncate"><%= trigger %></span>
    <%= render(UI::Icon.new(name: "chevron-right", size: :sm, class: "shrink-0 transition-transform duration-200 group-open/collapsible:rotate-90 motion-reduce:transition-none", aria: { hidden: true })) %>
  <% end %>
  <%= tag.div(class: content_classes) { content } %>
<% end %>

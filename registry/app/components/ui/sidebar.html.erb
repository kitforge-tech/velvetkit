<%= tag.aside(**@system_args) do %>
  <div data-slot="sidebar-backdrop" aria-hidden="true" class="<%= backdrop_classes %>" data-action="click->ui--sidebar#close"></div>
  <div data-slot="sidebar-container" class="<%= container_classes %>" data-ui--sidebar-target="container" data-action="click->ui--sidebar#navigate">
    <div data-sidebar="sidebar" data-slot="sidebar-inner" class="bg-sidebar flex h-full w-full flex-col overflow-hidden shadow-xl md:shadow-none group-data-[variant=floating]:border-sidebar-border group-data-[variant=floating]:rounded-lg group-data-[variant=floating]:border md:group-data-[variant=floating]:shadow-sm">
      <%= sidebar_header if sidebar_header %>
      <%= sidebar_content if sidebar_content %>
      <%= sidebar_footer if sidebar_footer %>
      <%= content %>
    </div>
  </div>
<% end %>

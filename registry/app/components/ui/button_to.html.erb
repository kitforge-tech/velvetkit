<%= button_to @path, **button_options do %><% if @loading %><span class="sr-only"><%= t("ui.button.loading", default: "Loading, please wait") %></span><%= render(loader_icon) %><% elsif leading_icon? %><%= leading_icon %><% end %><%= content %><% if trailing_icon? && !@loading %><%= trailing_icon %><% end %><% end %>

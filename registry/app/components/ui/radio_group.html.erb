<% wrapped = fieldset.wrap? %>
<%# Inside a fieldset, the fieldset has the role and the name. %>
<% group = capture do %><%= tag.div role: ("radiogroup" unless wrapped), id: group_id, class: classes, **@html_attrs.except(:id) do %><% items.each do |item| %><%= render item %><% end %><% end %><% end %>
<% if wrapped %><%= render(fieldset) { group } %><% else %><%= group %><% end %>

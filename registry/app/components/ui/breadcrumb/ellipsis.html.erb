<%= tag.li class: "inline-flex items-center gap-1.5", **@html_attrs do %>
  <% if content? %>
    <%= render(UI::Popover.new) do |popover| %>
      <% popover.with_trigger(variant: :ghost, size: :icon_sm, class: @user_class, aria: { label: t("ui.breadcrumb.ellipsis_label", default: "More breadcrumb pages") }) do %>
        <%= render(UI::Icon.new(name: :ellipsis, size: :sm)) %>
      <% end %>
      <% popover.with_content(side: :bottom, align: :start, class: "w-auto min-w-0 p-1") do %>
        <ul class="flex flex-col gap-0.5" aria-label="<%= t("ui.breadcrumb.collapsed_pages_label", default: "Collapsed breadcrumb pages") %>">
          <%= content %>
        </ul>
      <% end %>
    <% end %>
  <% else %>
    <span role="presentation" aria-hidden="true" class="<%= cn('text-muted-foreground/70', @user_class) %>">
      <%= render(UI::Icon.new(name: :ellipsis, size: :sm)) %>
    </span>
  <% end %>
<% end %>

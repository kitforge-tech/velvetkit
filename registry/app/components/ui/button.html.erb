<%= tag.button type: @type, class: classes, disabled: effective_disabled?, aria: { busy: @loading }, **@html_attrs do %><% if @loading %><span class="sr-only"><%= t("ui.button.loading", default: "Loading, please wait") %></span><%= render(loader_icon) %><% elsif leading_icon? %><%= leading_icon %><% end %><%= content %><% if trailing_icon? && !@loading %><%= trailing_icon %><% end %><% end %>

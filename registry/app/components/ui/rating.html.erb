<% if input? %><% stars = capture do %><%= tag.div(**stars_attrs) do %><% 1.upto(max * 2) do |step| %><% value = option_value(step) %><%= tag.input(type: "radio", id: option_id(value), name: input_name, value: value, checked: chosen_steps == step, required: required?, disabled: disabled?, class: "sr-only", data: { action: "change->ui--rating#reset" }) %><%= tag.label(for: option_id(value), class: star_classes(step), data: { "ui--rating-target": "star", value: value, action: "mouseenter->ui--rating#preview" }) do %><span aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden"><span class="<%= star_icon_classes(step) %>"><%= render(UI::Icon.new(name: icon, class: "fill-current")) %></span></span><span class="sr-only"><%= option_label(value) %></span><% end %><% end %><% end %><% end %><% if fieldset.wrap? %><%= render(fieldset) { stars } %><% else %><%= stars %><% end %><% else %><%= tag.span(**display_attrs) do %>
  <span role="img" aria-label="<%= image_label %>" class="<%= variant_classes(size: @size) %>">
    <% fills.each do |fill| %>
      <% if fill == :half %>
        <span class="relative inline-flex <%= UI::Rating::OFF %>">
          <%= render(UI::Icon.new(name: icon, class: "fill-current")) %>
          <span class="absolute inset-y-0 start-0 flex w-1/2 overflow-hidden <%= UI::Rating::ON %>"><%= render(UI::Icon.new(name: icon, class: "fill-current")) %></span>
        </span>
      <% else %>
        <%= render(UI::Icon.new(name: icon, class: class_names("fill-current", fill == :full ? UI::Rating::ON : UI::Rating::OFF))) %>
      <% end %>
    <% end %>
  </span>
  <% if show_value? %><span class="font-medium tabular-nums" aria-hidden="true"><%= formatted_score %></span><% end %>
  <% if count? %><span class="text-muted-foreground"><span aria-hidden="true">(<%= formatted_count %>)</span><span class="sr-only"><%= count_label %></span></span><% end %>
<% end %><% end %>

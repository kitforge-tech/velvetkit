<%= tag.div(**root_attrs) do %>
  <% if render_label? %>
    <%= tag.label for: input_id, class: "mb-1.5 block text-sm font-medium text-foreground" do %><%= label_text %><% if required? %><span class="ml-0.5 text-destructive">*</span><% end %><% end %>
  <% end %>

  <%= tag.div class: group_classes do %>
    <%# What people type. Not named: only the hidden ISO fields are submitted,
        so a half-typed date can't reach the server. %>
    <% fields.each_with_index do |(target, _, iso), index| %>
      <% if index.positive? %><span class="shrink-0 text-muted-foreground" aria-hidden="true">–</span><% end %>
      <%= tag.input(**input_attrs(target, iso)) %>
    <% end %>
    <span class="ml-auto flex h-full shrink-0 items-center">
      <%= tag.button type: "button", hidden: !value? || required? || disabled?,
                     aria: { label: t("ui.date_picker.clear", default: "Clear") },
                     class: "flex size-7 items-center justify-center rounded-sm text-muted-foreground hover:text-foreground #{UI::Base::FOCUS_RING}",
                     data: { "ui--date-picker-target": "clear", action: "ui--date-picker#clear" } do %>
        <%= render(UI::Icon.new(name: "x", size: :sm)) %>
      <% end %>
      <%= tag.button type: "button", disabled: disabled?, tabindex: -1,
                     aria: { haspopup: "dialog", expanded: "false", controls: panel_id, label: t("ui.date_picker.open", default: "Open the calendar") },
                     class: "flex h-full w-9 items-center justify-center rounded-r-md text-muted-foreground hover:text-foreground focus:outline-none",
                     data: { "ui--date-picker-target": "toggle", action: "ui--date-picker#toggle" } do %>
        <%= render(UI::Icon.new(name: "calendar", size: :sm)) %>
      <% end %>
    </span>
  <% end %>
  <% fields.each do |target, name, iso| %>
    <%= tag.input type: "hidden", name: name, value: iso, data: { "ui--date-picker-target": "hidden", field: target } %>
  <% end %>

  <% if render_hint? %>
    <%= tag.p hint_text, id: hint_id, class: "mt-1 text-xs text-muted-foreground" %>
  <% end %>
  <% if wrapper.error_message %>
    <%= tag.p wrapper.error_message, id: wrapper.error_id, class: "mt-1 text-xs text-destructive" %>
  <% end %>

  <%# Below the field, or a sheet from the bottom of the screen on a phone. %>
  <%= tag.div id: panel_id, role: "dialog", hidden: true,
              aria: { label: t(range? ? "ui.date_picker.dialog_range" : "ui.date_picker.dialog", default: range? ? "Choose dates" : "Choose a date") },
              class: "absolute left-0 top-full z-40 mt-1 flex w-max flex-col rounded-md border bg-popover text-popover-foreground shadow-md " \
                     "sm:flex-row max-sm:fixed max-sm:inset-x-0 max-sm:top-auto max-sm:bottom-0 max-sm:mt-0 max-sm:w-auto " \
                     "max-sm:max-h-[85dvh] max-sm:overflow-y-auto max-sm:rounded-b-none max-sm:border-x-0 max-sm:border-b-0",
              data: { "ui--date-picker-target": "panel" } do %>
    <% if preset_list.any? %>
      <%= tag.ul class: "flex gap-1 overflow-x-auto border-b p-2 sm:flex-col sm:overflow-visible sm:border-b-0 sm:border-e",
                 aria: { label: t("ui.date_picker.presets_label", default: "Quick ranges") } do %>
        <% preset_list.each do |name, from, to| %>
          <li class="shrink-0"><%= tag.button name, type: "button", aria: { pressed: preset_pressed?(from, to).to_s },
                                              class: "w-full whitespace-nowrap rounded-md px-3 py-1.5 text-start text-sm hover:bg-accent hover:text-accent-foreground " \
                                                     "aria-pressed:bg-primary/10 aria-pressed:font-medium aria-pressed:text-primary dark:aria-pressed:text-foreground #{UI::Base::FOCUS_RING}",
                                              data: { action: "ui--date-picker#preset", "ui--date-picker-from-param": from,
                                                      "ui--date-picker-to-param": to, "ui--date-picker-target": "preset" } %></li>
        <% end %>
      <% end %>
    <% end %>
    <div class="flex min-w-0 flex-col">
      <%# The calendar replaces the classes of the element it's given, so the
          kit's colours sit on this wrapper instead. %>
      <div class="velvetkit-calendar p-2"><%= tag.div data: { "ui--date-picker-target": "calendar" } %></div>
      <% if range? %>
        <%= tag.p "", role: "status", class: "min-h-5 px-4 pb-3 text-xs text-muted-foreground", data: { "ui--date-picker-target": "status" } %>
      <% end %>
    </div>
  <% end %>
<% end %>

<% if label.present? %>
  <%= tag.label for: id, class: wrapper_classes do %>
    <%= tag.span class: "relative inline-flex" do %>
      <%= tag.input(**input_options) %>
      <%= tag.span class: dot_classes do %>
        <%= tag.span class: dot_size_class + " rounded-full bg-primary-foreground" %>
      <% end %>
    <% end %>
    <%= tag.span class: label_text_classes do %><%= label %><% if required? %><%= tag.span(" *", class: "text-destructive ml-0.5") %><% end %><% end %>
  <% end %>
<% else %>
  <%= tag.span class: "relative inline-flex" do %>
    <%= tag.input(**input_options) %>
    <%= tag.span class: dot_classes do %>
      <%= tag.span class: dot_size_class + " rounded-full bg-primary-foreground" %>
    <% end %>
  <% end %>
<% end %>

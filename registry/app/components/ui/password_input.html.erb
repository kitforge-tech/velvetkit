<%# frozen_string_literal: true %>
<%# The Stimulus targets live on wrapper spans, not the icons themselves:
    UI::Icon sets its own `data: { lucide: ... }`, and a second `data:` hash
    passed through html_attrs replaces it wholesale, leaving a blank icon.
    Visibility uses an inline style rather than a `hidden` class so no
    utility-layer ordering can leave both icons showing at once. %>
<% group = capture do %><%= render(group_component) do |g| %>
  <% g.with_field(**field_options) %>
  <% g.with_addon(align: "inline-end") do |addon| %>
    <% addon.with_icon_button(**toggle_button_options) do %><span class="inline-flex" data-ui--password-visibility-target="iconShow"><%= render(UI::Icon.new(name: "eye", size: :sm)) %></span><span class="inline-flex" style="display: none" data-ui--password-visibility-target="iconHide"><%= render(UI::Icon.new(name: "eye-off", size: :sm)) %></span><% end %>
  <% end %>
<% end %><% end %>
<% if render_label? %>
  <div class="flex flex-col gap-2 w-full">
    <%= render(label_component) { label_text } %>
    <%= group %>
  </div>
<% else %>
  <%= group %>
<% end %>
